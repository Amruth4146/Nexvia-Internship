# MarketSphere Server Environment Configuration (India E-Commerce Architecture)

# Server Settings
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Business & Currency Configuration (Indian Marketplace)
CURRENCY=INR
CURRENCY_SYMBOL=₹
FREE_SHIPPING_THRESHOLD_INR=999
DEFAULT_SHIPPING_FEE_INR=99
DEFAULT_GST_PERCENT=18
DEFAULT_COMMISSION_PERCENT=10

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/marketsphere
MONGO_USER=
MONGO_PASSWORD=

# Redis Cache Settings
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Elasticsearch Settings (Set to false or leave unset to use native MongoDB search)
ELASTICSEARCH_ENABLED=false
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_access_key_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# Razorpay Payment Gateway (Indian Payment Ecosystem: UPI, Cards, Netbanking)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
# Webhook secret configured in Razorpay dashboard to verify asynchronous webhook signatures
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# AWS S3 Cloud Storage (ap-south-1 Mumbai Region)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=marketsphere-assets-prod
# Optional: CloudFront CDN domain for private S3 bucket access (e.g., d123456abcdef8.cloudfront.net)
AWS_CLOUDFRONT_DOMAIN=
